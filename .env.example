# DeepSeek API - získejte na https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Lokálně: `npm run dev` používá port 4180 (viz package.json). V Dockeru je host http://localhost:4180.
# Volitelně: kanonická URL webu (absolutní odkazy v AI system promptu). Na Vercelu často stačí VERCEL_URL.
# NEXT_PUBLIC_SITE_URL=https://www.mamka-reality.cz

# Volitelně: vlastní endpoint chatu (hybrid mimo Next). Jinak klient volá /api/chat.
# NEXT_PUBLIC_CHAT_API_URL=https://example.com/api/chat

# Admin /admin (server-only — nikdy NEXT_PUBLIC; na Vercelu nastavte v Environment Variables)
ADMIN_EMAIL=vas@email.cz
ADMIN_PASSWORD=change-me-strong

# Formspree (https://formspree.io) — stejné ID jako u kontaktního formuláře (components/Contact.tsx); pro odeslání poptávky z AI chatu (/api/inquiry) nastav lokálně i na Vercelu.
FORMSPREE_FORM_ID=your-formspree-form-id
